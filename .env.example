# GameNight — configuration
#
# Copy this file to `.env` and edit what you need:
#
#   cp .env.example .env
#
# `.env` is gitignored, never committed, and read at startup by config.js — so it
# works the same way whether you launch with `npm start`, `start.bat`,
# `check-and-start.ps1` or `docker compose up`. Every value below is the default:
# an empty `.env` behaves exactly like no `.env` at all.
#
# A variable already set in the environment wins over this file, so
# `PORT=5000 npm start` still overrides it.

# ─── Network ───

# Port the server listens on.
PORT=4000

# Interface to bind. 0.0.0.0 = reachable from the whole LAN (what you want for a
# party). 127.0.0.1 = this machine only, e.g. behind a local reverse proxy.
HOST=0.0.0.0

# Advertise the server over mDNS/Bonjour so friends can type gamenight.local
# instead of an IP. Turn it off in a bridged container, where it cannot work.
MDNS_ENABLED=true

# Hostname published over mDNS.
MDNS_HOST=gamenight.local

# ─── Quiz ───

# Where Quiz questions come from:
#   auto    try the internet, fall back to the bundled bank if it is unreachable
#   online  the internet only — a failure sends the room back to the lobby
#   offline never leave the LAN, always use the bundled bank
QUIZ_SOURCE=auto

# Trivia API. Point it at a mirror if opentdb.com is blocked; the response has to
# match the OpenTDB shape.
QUIZ_API_URL=https://opentdb.com/api.php
